-- | CantonSyndex.Test
-- Complete DAML Script lifecycle test for the CantonSyndex syndicated loan engine.
--
-- This script validates:
--   1. MasterFacility creation and constraint enforcement
--   2. Tranche syndication with bilateral privacy guarantees
--   3. Borrower drawdown and pro-rata distribution
--   4. Privacy isolation: Bank A cannot query Bank B's contracts
--   5. Repayment settlement and receipt generation
--   6. Facility deactivation
--
-- Run with:
--   daml test --files daml/CantonSyndex/Test.daml
module CantonSyndex.Test where

import Daml.Script
import CantonSyndex.Core

-- ---------------------------------------------------------------------------
-- | Main lifecycle test: $100M USD syndicated facility
-- ---------------------------------------------------------------------------
testSyndicatedLoanLifecycle : Script ()
testSyndicatedLoanLifecycle = script do

  -- =========================================================================
  -- STEP 0: Allocate Canton Participant Parties
  -- =========================================================================
  borrower <- allocatePartyWithHint "BorrowerCorp"  (PartyIdHint "BORROWER")
  agent    <- allocatePartyWithHint "GlobalLeadBank" (PartyIdHint "AGENT")
  bankA    <- allocatePartyWithHint "AlphaBank"      (PartyIdHint "BANK_A")
  bankB    <- allocatePartyWithHint "BetaBank"       (PartyIdHint "BANK_B")
  regulator <- allocatePartyWithHint "CentralBank"   (PartyIdHint "REGULATOR")

  -- =========================================================================
  -- STEP 1: Establish Master Facility ($100M USD)
  -- Signatories: borrower + agent
  -- Observer: regulator (read-only systemic oversight)
  -- =========================================================================
  facilityCid <- submitMulti [borrower, agent] [] do
    createCmd MasterFacility with
      facilityId  = "FAC-2026-USD-100M"
      borrower    = borrower
      agent       = agent
      currency    = "USD"
      totalLimit  = 100_000_000.0
      drawnAmount = 0.0
      isActive    = True
      regulator   = Some regulator

  -- Verify regulator can query the facility (read-only observer)
  regulatorView <- queryFilter @MasterFacility regulator
    (\f -> f.facilityId == "FAC-2026-USD-100M")
  assertMsg "Regulator should see the facility" (length regulatorView == 1)

  -- =========================================================================
  -- STEP 2: Syndicate Tranches (Bilateral Allocations)
  -- Bank A: $60M @ 150 bps (1.50% margin)
  -- Bank B: $40M @ 175 bps (1.75% margin) — different negotiated terms
  -- =========================================================================
  trancheACid <- submit agent do
    exerciseCmd facilityCid SyndicateTranche with
      lender           = bankA
      commitmentAmount = 60_000_000.0
      marginSpreadBps  = 150.0

  trancheBCid <- submit agent do
    exerciseCmd facilityCid SyndicateTranche with
      lender           = bankB
      commitmentAmount = 40_000_000.0
      marginSpreadBps  = 175.0

  -- Verify each bank can see their own tranche
  bankAOwnTranches <- queryFilter @TrancheParticipation bankA
    (\t -> t.lender == bankA)
  assertMsg "Bank A should see its own tranche" (length bankAOwnTranches == 1)

  bankBOwnTranches <- queryFilter @TrancheParticipation bankB
    (\t -> t.lender == bankB)
  assertMsg "Bank B should see its own tranche" (length bankBOwnTranches == 1)

  -- =========================================================================
  -- STEP 3: PRIVACY ISOLATION VERIFICATION (CRITICAL TEST)
  --
  -- Bank A queries for contracts where lender == bankB.
  -- Due to Canton sub-transaction privacy, Bank A has ZERO mathematical
  -- visibility into Bank B's TrancheParticipation contract.
  -- This assertion MUST return an empty list.
  -- =========================================================================
  bankAVisibleBTranches <- queryFilter @TrancheParticipation bankA
    (\t -> t.lender == bankB)
  assertMsg
    "PRIVACY VIOLATION: Bank A must not see Bank B's tranche allocation"
    (null bankAVisibleBTranches)

  -- Reciprocal: Bank B cannot see Bank A's tranche
  bankBVisibleATranches <- queryFilter @TrancheParticipation bankB
    (\t -> t.lender == bankA)
  assertMsg
    "PRIVACY VIOLATION: Bank B must not see Bank A's tranche allocation"
    (null bankBVisibleATranches)

  -- =========================================================================
  -- STEP 4: Borrower Requests $20M Drawdown
  -- =========================================================================
  (updatedFacilityCid, drawdownCid) <- submit borrower do
    exerciseCmd facilityCid RequestDrawdown with
      drawdownId = "DRAW-001"
      amount     = 20_000_000.0

  -- Verify facility drawn amount updated
  facilityState <- queryContractId borrower updatedFacilityCid
  case facilityState of
    None    -> assertFail "Updated facility contract not found"
    Some fc -> assertMsg
      "Facility drawnAmount should be $20M after drawdown"
      (fc.drawnAmount == 20_000_000.0)

  -- =========================================================================
  -- STEP 5: Agent Distributes Pro-Rata Drawdown
  -- Bank A gets 60% of $20M = $12M
  -- Bank B gets 40% of $20M = $8M
  -- =========================================================================
  updatedTrancheACid <- submit agent do
    exerciseCmd trancheACid ApplyTrancheDrawdown with
      drawAmount = 12_000_000.0

  updatedTrancheBCid <- submit agent do
    exerciseCmd trancheBCid ApplyTrancheDrawdown with
      drawAmount = 8_000_000.0

  -- Verify Bank A drawn balance
  trancheAState <- queryContractId agent updatedTrancheACid
  case trancheAState of
    None    -> assertFail "Updated tranche A not found"
    Some ta -> assertMsg
      "Bank A drawn amount should be $12M"
      (ta.drawnAmount == 12_000_000.0)

  -- Mark drawdown as executed
  _ <- submit agent do
    exerciseCmd drawdownCid MarkDrawdownExecuted

  -- =========================================================================
  -- STEP 6: Repayment Settlement ($5M principal + interest for Bank A)
  -- =========================================================================
  (settledTrancheACid, receiptACid) <- submit agent do
    exerciseCmd updatedTrancheACid SettleRepayment with
      principalPaid = 5_000_000.0
      interestPaid  = 25_000.0  -- 5M * 1.50% * 30/365 ≈ $6,164 (simplified)
      timestamp     = "2026-09-28T00:00:00Z"

  -- Verify Bank A can read their repayment receipt
  bankAReceipts <- queryFilter @RepaymentReceipt bankA
    (\r -> r.lender == bankA)
  assertMsg "Bank A should receive repayment receipt" (length bankAReceipts == 1)

  -- Bank B should NOT see Bank A's receipt (strict privacy)
  bankBVisibleAReceipts <- queryFilter @RepaymentReceipt bankB
    (\r -> r.lender == bankA)
  assertMsg
    "PRIVACY VIOLATION: Bank B must not see Bank A's repayment receipt"
    (null bankBVisibleAReceipts)

  -- Verify settled tranche A drawn amount reduced
  settledTrancheAState <- queryContractId agent settledTrancheACid
  case settledTrancheAState of
    None    -> assertFail "Settled tranche A not found"
    Some st -> assertMsg
      "Bank A drawn balance should be $7M after $5M repayment"
      (st.drawnAmount == 7_000_000.0)

  -- =========================================================================
  -- STEP 7: Facility Deactivation
  -- =========================================================================
  deactivatedFacilityCid <- submit agent do
    exerciseCmd updatedFacilityCid DeactivateFacility

  finalFacilityState <- queryContractId agent deactivatedFacilityCid
  case finalFacilityState of
    None    -> assertFail "Deactivated facility not found"
    Some ff -> assertMsg "Facility should be inactive" (not ff.isActive)

  return ()

-- ---------------------------------------------------------------------------
-- | Negative test: Verify constraint violations are rejected
-- ---------------------------------------------------------------------------
testConstraintViolations : Script ()
testConstraintViolations = script do

  borrower <- allocatePartyWithHint "BorrowerCorp2" (PartyIdHint "BORROWER2")
  agent    <- allocatePartyWithHint "AgentBank2"    (PartyIdHint "AGENT2")
  bankA    <- allocatePartyWithHint "AlphaBank2"    (PartyIdHint "BANK_A2")

  facilityCid <- submitMulti [borrower, agent] [] do
    createCmd MasterFacility with
      facilityId  = "FAC-2026-USD-50M"
      borrower    = borrower
      agent       = agent
      currency    = "USD"
      totalLimit  = 50_000_000.0
      drawnAmount = 0.0
      isActive    = True
      regulator   = None

  -- Test: Over-commitment should be rejected
  result <- tryToEither $ submit agent do
    exerciseCmd facilityCid SyndicateTranche with
      lender           = bankA
      commitmentAmount = 60_000_000.0  -- Exceeds $50M facility limit
      marginSpreadBps  = 150.0
  case result of
    Left  _ -> return ()  -- Expected: constraint violation
    Right _ -> assertFail "Over-commitment should have been rejected"

  return ()

-- ---------------------------------------------------------------------------
-- | testInterestAccrualActual365
--
-- Validates the full interest accrual lifecycle for a 30-day period:
--   1. Create InterestAccrual (AlphaBank, $12M @ 150bps + 530bps SOFR)
--   2. AccrueInterest at day 30
--   3. Verify accrued amount matches Actual/365 formula
--   4. CollectInterest → creates InterestPaymentReceipt
--   5. Verify privacy: BetaBank cannot see AlphaBank's receipt
-- ---------------------------------------------------------------------------
testInterestAccrualActual365 : Script ()
testInterestAccrualActual365 = script do

  agent <- allocatePartyWithHint "GlobalLeadBank3" (PartyIdHint "AGENT3")
  bankA <- allocatePartyWithHint "AlphaBank3"      (PartyIdHint "BANK_A3")
  bankB <- allocatePartyWithHint "BetaBank3"       (PartyIdHint "BANK_B3")

  let periodStart = date 2026 Aug 1
      periodEnd   = date 2026 Sep 1  -- 31 calendar days
      accrualDay  = date 2026 Sep 1  -- Accrue to period end
      settleDay   = date 2026 Sep 2  -- Settle one business day after

  -- =========================================================================
  -- STEP 1: Create InterestAccrual for AlphaBank
  --   Principal: $12,000,000
  --   Margin:    150 bps (1.50%)
  --   SOFR:      530 bps (5.30%) — total all-in 6.80% / 365
  -- =========================================================================
  accrualCidA <- submitMulti [agent, bankA] [] do
    createCmd InterestAccrual with
      facilityId        = "FAC-2026-USD-100M"
      trancheId         = "ACCRUE-ALPHA-001"
      agent             = agent
      lender            = bankA
      principalBalance  = 12_000_000.0
      marginSpreadBps   = 150.0
      baseRateBps       = 530.0   -- SOFR substitute
      periodStartDate   = periodStart
      periodEndDate     = periodEnd
      dayCountConvention = Actual365Fixed
      accruedInterest   = 0.0
      isSettled         = False

  -- =========================================================================
  -- STEP 2: AccrueInterest to day 31 (Aug 1 → Sep 1 = 31 actual days)
  --
  -- Expected calculation (Actual/365):
  --   totalRateBps = 150 + 530 = 680
  --   days         = 31 (subDate Sep 1 Aug 1)
  --   interest     = 12,000,000 * (680/10000) * (31/365)
  --                = 12,000,000 * 0.0680 * 0.08493...
  --                = $69,304.11 (approx)
  -- =========================================================================
  updatedAccrualCidA <- submit agent do
    exerciseCmd accrualCidA AccrueInterest with
      accrualDate = accrualDay

  -- Verify accrued amount is reasonable (within 1 USD of expected)
  accrualStateA <- queryContractId agent updatedAccrualCidA
  case accrualStateA of
    None -> assertFail "Accrual contract not found after AccrueInterest"
    Some ac -> do
      let expectedInterest = 12_000_000.0 * (680.0 / 10000.0) * (31.0 / 365.0)
          tolerance        = 1.0  -- Allow $1 rounding tolerance
      assertMsg
        ("AccrueInterest calculation mismatch. Got: " <> show ac.accruedInterest <>
         " Expected: " <> show expectedInterest)
        (ac.accruedInterest >= expectedInterest - tolerance &&
         ac.accruedInterest <= expectedInterest + tolerance)

  -- =========================================================================
  -- STEP 3: CollectInterest → creates InterestPaymentReceipt
  -- =========================================================================
  receiptCidA <- submit agent do
    exerciseCmd updatedAccrualCidA CollectInterest with
      settlementDate = settleDay

  -- =========================================================================
  -- STEP 4: Verify receipt visibility
  --   AlphaBank (observer) should see its own receipt
  --   BetaBank should NOT see AlphaBank's receipt (Canton privacy)
  -- =========================================================================
  bankAReceipts <- queryFilter @InterestPaymentReceipt bankA
    (\r -> r.trancheId == "ACCRUE-ALPHA-001")
  assertMsg "AlphaBank should see its own interest receipt" (length bankAReceipts == 1)

  -- Verify receipt fields
  case bankAReceipts of
    [(_, r)] -> do
      assertMsg "Receipt facility ID should match" (r.facilityId == "FAC-2026-USD-100M")
      assertMsg "Receipt margin should be 150 bps"  (r.marginSpreadBps == 150.0)
      assertMsg "Receipt base rate should be 530 bps" (r.baseRateBps == 530.0)
      assertMsg "Receipt principal should be $12M"   (r.principalBalance == 12_000_000.0)
    _ -> assertFail "Expected exactly one receipt"

  -- PRIVACY: BetaBank cannot see AlphaBank's interest receipt
  bankBVisibleReceipts <- queryFilter @InterestPaymentReceipt bankB
    (\r -> r.lender == bankA)
  assertMsg
    "PRIVACY VIOLATION: BetaBank must not see AlphaBank's interest receipt"
    (null bankBVisibleReceipts)

  return ()

-- ---------------------------------------------------------------------------
-- | testInterestAccrualConventions
--
-- Cross-validates all three DayCountConvention values produce different
-- accrued interest amounts for the same principal/rate/days inputs.
-- Actual365Fixed > Actual360 (same days, larger denominator = less interest
-- ... wait: larger denominator = LESS interest. Actual360 gives MORE interest).
-- ---------------------------------------------------------------------------
testInterestAccrualConventions : Script ()
testInterestAccrualConventions = script do

  agent <- allocatePartyWithHint "GlobalLeadBank4" (PartyIdHint "AGENT4")
  bankA <- allocatePartyWithHint "AlphaBank4"      (PartyIdHint "BANK_A4")

  let periodStart = date 2026 Jan 1
      periodEnd   = date 2026 Apr 1   -- Q1: 90 actual days
      accrualDay  = date 2026 Apr 1

  let makeAccrual convention trancheId = submitMulti [agent, bankA] [] do
        createCmd InterestAccrual with
          facilityId        = "FAC-CONV-TEST"
          trancheId         = trancheId
          agent             = agent
          lender            = bankA
          principalBalance  = 10_000_000.0
          marginSpreadBps   = 200.0  -- 2.00%
          baseRateBps       = 500.0  -- 5.00% — total 7.00%
          periodStartDate   = periodStart
          periodEndDate     = periodEnd
          dayCountConvention = convention
          accruedInterest   = 0.0
          isSettled         = False

  -- Create three parallel accruals with different conventions
  cid365   <- makeAccrual Actual365Fixed "ACCRUE-365"
  cid360   <- makeAccrual Actual360      "ACCRUE-360"
  cidThirty <- makeAccrual Thirty360     "ACCRUE-30-360"

  -- Accrue all three
  updated365   <- submit agent do exerciseCmd cid365    AccrueInterest with accrualDate = accrualDay
  updated360   <- submit agent do exerciseCmd cid360    AccrueInterest with accrualDate = accrualDay
  updatedThirty <- submit agent do exerciseCmd cidThirty AccrueInterest with accrualDate = accrualDay

  -- Query results
  state365    <- queryContractId agent updated365
  state360    <- queryContractId agent updated360
  stateThirty <- queryContractId agent updatedThirty

  case (state365, state360, stateThirty) of
    (Some s365, Some s360, Some sT) -> do
      -- Actual/360 should yield MORE interest than Actual/365 (smaller denominator)
      assertMsg
        "Actual360 should accrue more interest than Actual365Fixed (smaller denominator)"
        (s360.accruedInterest > s365.accruedInterest)
      -- Both Actual/360 and Thirty360 use 360-day basis → same result for 90-day Q1
      -- (Thirty360 also uses actual days in this implementation)
      assertMsg
        "All conventions should produce positive interest"
        (s365.accruedInterest > 0.0 && s360.accruedInterest > 0.0 && sT.accruedInterest > 0.0)
    _ -> assertFail "Could not query one or more accrual contracts"

  return ()

-- ---------------------------------------------------------------------------
-- | testCovenantCompliantPath
--
-- Validates the happy path: two consecutive quarterly tests both pass.
-- Verifies that lenders and regulator can see FacilityCovenants (observer).
-- ---------------------------------------------------------------------------
testCovenantCompliantPath : Script ()
testCovenantCompliantPath = script do

  borrower  <- allocatePartyWithHint "BorrowerCorp5"   (PartyIdHint "BORROWER5")
  agent     <- allocatePartyWithHint "GlobalLeadBank5" (PartyIdHint "AGENT5")
  bankA     <- allocatePartyWithHint "AlphaBank5"      (PartyIdHint "BANK_A5")
  bankB     <- allocatePartyWithHint "BetaBank5"       (PartyIdHint "BANK_B5")
  regulator <- allocatePartyWithHint "CentralBank5"    (PartyIdHint "REGULATOR5")

  -- =========================================================================
  -- STEP 1: Create FacilityCovenants
  --   Thresholds: Leverage <= 4.5x, DSCR >= 1.25, LTV <= 75%, Liquidity >= 5M
  -- =========================================================================
  covenantCid <- submitMulti [borrower, agent] [] do
    createCmd FacilityCovenants with
      facilityId       = "FAC-2026-USD-100M"
      borrower         = borrower
      agent            = agent
      lenders          = [bankA, bankB]
      regulator        = Some regulator
      maxLeverageRatio = 4.5
      minDSCR          = 1.25
      maxLTV           = 0.75
      minLiquidity     = 5_000_000.0
      lastTestDate     = date 2026 Jan 1
      leverageActual   = 3.2
      dscrActual       = 1.8
      ltvActual        = 0.55
      liquidityActual  = 8_000_000.0
      breachStatus     = Compliant
      curePeriodDays   = 30

  -- =========================================================================
  -- STEP 2: Q1 covenant test — borrower within all thresholds
  -- =========================================================================
  q1Cid <- submit agent do
    exerciseCmd covenantCid TestCovenant with
      testDate     = date 2026 Apr 1
      newLeverage  = 3.8   -- ≤ 4.5 ✓
      newDSCR      = 1.45  -- ≥ 1.25 ✓
      newLTV       = 0.62  -- ≤ 0.75 ✓
      newLiquidity = 7_200_000.0  -- ≥ 5M ✓

  q1State <- queryContractId agent q1Cid
  case q1State of
    None    -> assertFail "Q1 covenant contract not found"
    Some cov -> assertMsg "Q1 should be Compliant" (cov.breachStatus == Compliant)

  -- =========================================================================
  -- STEP 3: Verify all observers can see the covenant contract
  -- =========================================================================
  bankAView <- queryContractId bankA q1Cid
  assertMsg "AlphaBank should see covenant contract as observer"
    (bankAView /= None)

  regulatorView <- queryContractId regulator q1Cid
  assertMsg "Regulator should see covenant contract as observer"
    (regulatorView /= None)

  -- =========================================================================
  -- STEP 4: Q2 covenant test — still compliant
  -- =========================================================================
  q2Cid <- submit agent do
    exerciseCmd q1Cid TestCovenant with
      testDate     = date 2026 Jul 1
      newLeverage  = 4.1   -- ≤ 4.5 ✓ (tightening but still OK)
      newDSCR      = 1.30  -- ≥ 1.25 ✓ (narrowing margin)
      newLTV       = 0.70  -- ≤ 0.75 ✓
      newLiquidity = 5_500_000.0  -- ≥ 5M ✓

  q2State <- queryContractId agent q2Cid
  case q2State of
    None    -> assertFail "Q2 covenant contract not found"
    Some cov -> assertMsg "Q2 should still be Compliant" (cov.breachStatus == Compliant)

  return ()

-- ---------------------------------------------------------------------------
-- | testCovenantBreachAndEnforcement
--
-- Validates the full breach → waiver → re-breach → acceleration workflow:
--   Q3: Leverage ratio breaches 4.5x threshold → status = Breached
--   Agent issues waiver with reason → status = WaivedByAgent
--   Q4: Leverage breaches again AND DSCR below minimum → Breached again
--   Agent accelerates → CovenantBreachNotice created
-- ---------------------------------------------------------------------------
testCovenantBreachAndEnforcement : Script ()
testCovenantBreachAndEnforcement = script do

  borrower  <- allocatePartyWithHint "BorrowerCorp6"   (PartyIdHint "BORROWER6")
  agent     <- allocatePartyWithHint "GlobalLeadBank6" (PartyIdHint "AGENT6")
  bankA     <- allocatePartyWithHint "AlphaBank6"      (PartyIdHint "BANK_A6")
  bankB     <- allocatePartyWithHint "BetaBank6"       (PartyIdHint "BANK_B6")
  regulator <- allocatePartyWithHint "CentralBank6"    (PartyIdHint "REGULATOR6")

  -- Setup: initial compliant covenants
  initCid <- submitMulti [borrower, agent] [] do
    createCmd FacilityCovenants with
      facilityId       = "FAC-2026-USD-100M"
      borrower         = borrower
      agent            = agent
      lenders          = [bankA, bankB]
      regulator        = Some regulator
      maxLeverageRatio = 4.5
      minDSCR          = 1.25
      maxLTV           = 0.75
      minLiquidity     = 5_000_000.0
      lastTestDate     = date 2026 Jun 30
      leverageActual   = 4.0
      dscrActual       = 1.40
      ltvActual        = 0.65
      liquidityActual  = 6_000_000.0
      breachStatus     = Compliant
      curePeriodDays   = 30

  -- =========================================================================
  -- Q3: Breach — leverage = 4.8x > 4.5x max
  -- =========================================================================
  q3Cid <- submit agent do
    exerciseCmd initCid TestCovenant with
      testDate     = date 2026 Oct 1
      newLeverage  = 4.8   -- > 4.5 ✗ BREACH
      newDSCR      = 1.30  -- ≥ 1.25 ✓
      newLTV       = 0.68  -- ≤ 0.75 ✓
      newLiquidity = 5_800_000.0  -- ≥ 5M ✓

  q3State <- queryContractId agent q3Cid
  case q3State of
    None    -> assertFail "Q3 covenant not found"
    Some cov -> assertMsg "Q3 leverage breach should set status to Breached"
                  (cov.breachStatus == Breached)

  -- =========================================================================
  -- Agent waives the Q3 breach (borrower provides cure plan)
  -- =========================================================================
  waivedCid <- submit agent do
    exerciseCmd q3Cid WaiveCovenantBreach with
      waiverReason = "Q3 leverage breach waived. Borrower provided 90-day \
                     \deleveraging plan; divestiture of non-core assets underway."

  waivedState <- queryContractId agent waivedCid
  case waivedState of
    None    -> assertFail "Waived covenant not found"
    Some cov -> assertMsg "Status should be WaivedByAgent" (cov.breachStatus == WaivedByAgent)

  -- Verify waiver guard: cannot waive a non-breached contract
  waiverOfWaived <- tryToEither $ submit agent do
    exerciseCmd waivedCid WaiveCovenantBreach with
      waiverReason = "Double waiver attempt"
  case waiverOfWaived of
    Left  _ -> return ()  -- Expected: guard rejects non-Breached status
    Right _ -> assertFail "WaiveCovenantBreach should reject non-Breached status"

  -- =========================================================================
  -- Q4: Re-breach — leverage AND DSCR both fail
  -- =========================================================================
  q4Cid <- submit agent do
    exerciseCmd waivedCid TestCovenant with
      testDate     = date 2027 Jan 1
      newLeverage  = 5.2   -- > 4.5 ✗ BREACH
      newDSCR      = 1.10  -- < 1.25 ✗ BREACH
      newLTV       = 0.72  -- ≤ 0.75 ✓
      newLiquidity = 5_100_000.0  -- ≥ 5M ✓

  q4State <- queryContractId agent q4Cid
  case q4State of
    None    -> assertFail "Q4 covenant not found"
    Some cov -> assertMsg "Q4 double-breach should be Breached" (cov.breachStatus == Breached)

  -- =========================================================================
  -- Agent accelerates — creates immutable CovenantBreachNotice
  -- =========================================================================
  noticeCid <- submit agent do
    exerciseCmd q4Cid AccelerateOnBreach with
      accelerationDate = date 2027 Jan 15
      noticeText       = "NOTICE OF ACCELERATION: Pursuant to Section 8.1 of \
                         \the Credit Agreement dated 2026-08-01, the Agent \
                         \hereby declares the outstanding principal and accrued \
                         \interest immediately due and payable. Leverage ratio \
                         \5.2x exceeded maximum 4.5x and DSCR 1.10x below \
                         \minimum 1.25x as at Q4 2026 test date."

  -- =========================================================================
  -- Verify CovenantBreachNotice visibility — all parties see it
  -- =========================================================================
  borrowerView  <- queryContractId borrower noticeCid
  bankAView     <- queryContractId bankA noticeCid
  bankBView     <- queryContractId bankB noticeCid
  regulatorView <- queryContractId regulator noticeCid

  assertMsg "Borrower must see CovenantBreachNotice" (borrowerView /= None)
  assertMsg "AlphaBank must see CovenantBreachNotice" (bankAView /= None)
  assertMsg "BetaBank must see CovenantBreachNotice"  (bankBView /= None)
  assertMsg "Regulator must see CovenantBreachNotice" (regulatorView /= None)

  -- Verify breach ratios are captured correctly on the notice
  case bankAView of
    None -> assertFail "BankA cannot see notice"
    Some notice -> do
      assertMsg "Notice leverage should match Q4 actual" (notice.leverageAtBreach == 5.2)
      assertMsg "Notice DSCR should match Q4 actual"     (notice.dscrAtBreach == 1.10)

  -- =========================================================================
  -- Guard: cannot accelerate already-archived FacilityCovenants
  -- =========================================================================
  doubleAccel <- tryToEither $ submit agent do
    exerciseCmd q4Cid AccelerateOnBreach with
      accelerationDate = date 2027 Jan 16
      noticeText = "Second acceleration attempt"
  case doubleAccel of
    Left  _ -> return ()  -- Expected: q4Cid is archived
    Right _ -> assertFail "Cannot accelerate an already-archived covenant contract"

  return ()
