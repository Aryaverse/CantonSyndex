-- | CantonSyndex.Core
-- Privacy-Preserving Syndicated Loan & Tranche Lifecycle Engine
-- Canton Network / DAML 2.x
--
-- This module contains the core smart contract templates that model
-- the full lifecycle of a syndicated loan facility with strict
-- sub-transaction privacy enforced by the Canton cryptographic protocol.
module CantonSyndex.Core where

import DA.Optional (optionalToList)

-- ---------------------------------------------------------------------------
-- | MasterFacility
--
-- Global facility contract jointly signed by the Borrower and the Lead Agent.
-- Encodes the top-level credit limit, currency, and aggregate drawn amount.
--
-- PRIVACY: Participant lenders are NOT observers on this contract.
--          They cannot see each other's allocations, margin spreads, or fees.
--          An optional Regulator party may be added as a read-only observer
--          for systemic-risk and capital-adequacy oversight.
-- ---------------------------------------------------------------------------
template MasterFacility
  with
    facilityId    : Text
      -- ^ Unique reference identifier (e.g. "FAC-2026-USD-100M")
    borrower      : Party
      -- ^ Corporate or sovereign borrower
    agent         : Party
      -- ^ Lead arranger / facility agent bank
    currency      : Text
      -- ^ ISO 4217 currency code (e.g. "USD", "EUR")
    totalLimit    : Decimal
      -- ^ Maximum aggregate credit commitment (e.g. 100_000_000.0)
    drawnAmount   : Decimal
      -- ^ Aggregate amount currently drawn by the borrower
    isActive      : Bool
      -- ^ Whether the facility is open for further drawdowns
    regulator     : Optional Party
      -- ^ Optional read-only compliance observer (e.g. central bank)
  where
    signatory borrower, agent
    observer (optionalToList regulator)

    -- Contract invariants enforced at creation and every state transition
    ensure
      totalLimit > 0.0 &&
      drawnAmount >= 0.0 &&
      drawnAmount <= totalLimit

    -- -----------------------------------------------------------------------
    -- Choice: SyndicateTranche
    -- Controller: agent (Lead Arranger)
    --
    -- Provisions a bilateral commitment for a single participant lender.
    -- The resulting TrancheParticipation is visible ONLY to the agent and
    -- the specific lender — all other banks have zero knowledge of its terms.
    -- -----------------------------------------------------------------------
    nonconsuming choice SyndicateTranche : ContractId TrancheParticipation
      with
        lender           : Party
          -- ^ Participant bank receiving the bilateral allocation
        commitmentAmount : Decimal
          -- ^ Dollar commitment for this lender (must fit within headroom)
        marginSpreadBps  : Decimal
          -- ^ Negotiated margin in basis points (e.g. 150.0 = 1.50%)
      controller agent
      do
        assertMsg
          "Commitment exceeds total facility headroom"
          (commitmentAmount <= (totalLimit - drawnAmount))
        assertMsg
          "Commitment amount must be positive"
          (commitmentAmount > 0.0)
        assertMsg
          "Margin spread must be non-negative"
          (marginSpreadBps >= 0.0)
        create TrancheParticipation with
          facilityId
          agent
          borrower
          lender
          commitmentAmount
          drawnAmount      = 0.0
          marginSpreadBps
          isActive         = True

    -- -----------------------------------------------------------------------
    -- Choice: RequestDrawdown
    -- Controller: borrower
    --
    -- Triggers an atomic drawdown event against remaining facility headroom.
    -- Creates an immutable DrawdownExecution audit record and advances the
    -- aggregate drawn counter on the MasterFacility.
    -- -----------------------------------------------------------------------
    choice RequestDrawdown : (ContractId MasterFacility, ContractId DrawdownExecution)
      with
        drawdownId : Text
          -- ^ Unique drawdown reference (e.g. "DRAW-001")
        amount     : Decimal
          -- ^ Requested drawdown amount (must not exceed headroom)
      controller borrower
      do
        assertMsg
          "Facility is currently inactive"
          isActive
        assertMsg
          "Requested amount exceeds available headroom"
          (amount <= (totalLimit - drawnAmount))
        assertMsg
          "Drawdown amount must be positive"
          (amount > 0.0)
        updatedFacilityCid <- create this with
          drawnAmount = drawnAmount + amount
        drawdownCid <- create DrawdownExecution with
          facilityId
          drawdownId
          borrower
          agent
          amount
          executed = False
        return (updatedFacilityCid, drawdownCid)

    -- -----------------------------------------------------------------------
    -- Choice: DeactivateFacility
    -- Controller: agent
    --
    -- Permanently closes the facility for further drawdowns.
    -- Existing tranches and receipts are unaffected.
    -- -----------------------------------------------------------------------
    choice DeactivateFacility : ContractId MasterFacility
      controller agent
      do
        create this with isActive = False

-- ---------------------------------------------------------------------------
-- | TrancheParticipation
--
-- Strict bilateral agreement between the Lead Agent and a single participant
-- lender. This is the privacy-critical contract — only the agent and the
-- designated lender are signatories; no other party holds any visibility.
--
-- PRIVACY: Bank B has ZERO mathematical visibility into Bank A's allocation,
--          negotiated margin spread, commitment fee, or drawn balance.
--          This guarantee is enforced by Canton's cryptographic protocol,
--          not by application-layer access control.
-- ---------------------------------------------------------------------------
template TrancheParticipation
  with
    facilityId       : Text
      -- ^ Reference back to the parent MasterFacility
    agent            : Party
      -- ^ Lead Arranger / Facility Agent bank
    borrower         : Party
      -- ^ Corporate or sovereign borrower (not a signatory here)
    lender           : Party
      -- ^ This specific participant bank
    commitmentAmount : Decimal
      -- ^ Maximum this lender has agreed to fund (e.g. 60_000_000.0)
    drawnAmount      : Decimal
      -- ^ Amount currently drawn from this lender's commitment
    marginSpreadBps  : Decimal
      -- ^ Bilaterally negotiated margin in basis points (e.g. 150.0)
    isActive         : Bool
      -- ^ Whether this tranche is open for further drawdowns
  where
    signatory agent, lender
    -- No observers — strict bilateral confidentiality
    ensure
      commitmentAmount > 0.0 &&
      drawnAmount >= 0.0 &&
      drawnAmount <= commitmentAmount

    -- -----------------------------------------------------------------------
    -- Choice: ApplyTrancheDrawdown
    -- Controller: agent
    --
    -- Distributes a pro-rata share of a borrower drawdown to this tranche.
    -- Called by the agent after RequestDrawdown succeeds on the MasterFacility.
    -- -----------------------------------------------------------------------
    choice ApplyTrancheDrawdown : ContractId TrancheParticipation
      with
        drawAmount : Decimal
          -- ^ This lender's pro-rata share of the drawdown
      controller agent
      do
        assertMsg
          "Drawdown share exceeds remaining commitment quota"
          (drawnAmount + drawAmount <= commitmentAmount)
        assertMsg
          "Draw amount must be positive"
          (drawAmount > 0.0)
        create this with drawnAmount = drawnAmount + drawAmount

    -- -----------------------------------------------------------------------
    -- Choice: SettleRepayment
    -- Controller: agent
    --
    -- Processes a repayment from the borrower, reducing the drawn balance
    -- and creating an immutable RepaymentReceipt as an audit confirmation.
    -- -----------------------------------------------------------------------
    choice SettleRepayment : (ContractId TrancheParticipation, ContractId RepaymentReceipt)
      with
        principalPaid : Decimal
          -- ^ Principal portion of this lender's repayment
        interestPaid  : Decimal
          -- ^ Interest portion calculated at marginSpreadBps
        timestamp     : Text
          -- ^ ISO-8601 settlement timestamp (e.g. "2026-08-28T00:00:00Z")
      controller agent
      do
        assertMsg
          "Principal repayment exceeds outstanding drawn balance"
          (principalPaid <= drawnAmount)
        assertMsg
          "Principal and interest must be non-negative"
          (principalPaid >= 0.0 && interestPaid >= 0.0)
        updatedTranche <- create this with
          drawnAmount = drawnAmount - principalPaid
        receiptCid <- create RepaymentReceipt with
          facilityId
          agent
          lender
          principalPaid
          interestPaid
          timestamp
        return (updatedTranche, receiptCid)

    -- -----------------------------------------------------------------------
    -- Choice: SuspendTranche
    -- Controller: agent
    --
    -- Temporarily suspends this lender's tranche (e.g. covenant breach).
    -- -----------------------------------------------------------------------
    choice SuspendTranche : ContractId TrancheParticipation
      controller agent
      do
        create this with isActive = False

-- ---------------------------------------------------------------------------
-- | DrawdownExecution
--
-- An immutable audit record created atomically when the borrower exercises
-- the RequestDrawdown choice on a MasterFacility. Records the intent and
-- amount of the drawdown event before pro-rata distribution to tranches.
--
-- Once the agent has distributed the drawdown to all participant tranches
-- via ApplyTrancheDrawdown, the `executed` flag should be archived via
-- MarkDrawdownExecuted.
-- ---------------------------------------------------------------------------
template DrawdownExecution
  with
    facilityId : Text
      -- ^ Reference to the parent MasterFacility
    drawdownId : Text
      -- ^ Unique drawdown reference identifier (e.g. "DRAW-001")
    borrower   : Party
      -- ^ Borrower who triggered the drawdown
    agent      : Party
      -- ^ Lead Agent responsible for distribution
    amount     : Decimal
      -- ^ Total drawdown amount requested
    executed   : Bool
      -- ^ Whether the agent has distributed to all tranches
  where
    signatory borrower, agent
    ensure amount > 0.0

    -- -----------------------------------------------------------------------
    -- Choice: MarkDrawdownExecuted
    -- Controller: agent
    --
    -- Marks the drawdown as fully distributed across all participant tranches.
    -- Creates an immutable archive of the execution event.
    -- -----------------------------------------------------------------------
    choice MarkDrawdownExecuted : ContractId DrawdownExecution
      controller agent
      do
        create this with executed = True

-- ---------------------------------------------------------------------------
-- | RepaymentReceipt
--
-- An immutable, lender-specific audit confirmation generated when the agent
-- processes a repayment via SettleRepayment on a TrancheParticipation.
--
-- PRIVACY: Each lender receives ONLY their own receipt. No cross-lender
--          visibility into other participants' principal or interest amounts.
-- ---------------------------------------------------------------------------
template RepaymentReceipt
  with
    facilityId    : Text
      -- ^ Reference to the parent MasterFacility
    agent         : Party
      -- ^ Lead Agent who processed the repayment
    lender        : Party
      -- ^ Participant lender receiving this settlement confirmation
    principalPaid : Decimal
      -- ^ Principal amount repaid to this lender
    interestPaid  : Decimal
      -- ^ Interest amount paid at the bilaterally agreed margin spread
    timestamp     : Text
      -- ^ ISO-8601 settlement timestamp (e.g. "2026-08-28T12:00:00Z")
  where
    signatory agent
    observer lender
      -- ^ Lender is a read-only observer — receives the receipt but
      --   cannot modify it (immutable audit trail)
    ensure
      principalPaid >= 0.0 &&
      interestPaid >= 0.0

-- ---------------------------------------------------------------------------
-- | DayCountConvention
--
-- Enumerates the interest day-count conventions used in capital markets.
-- The choice of convention affects how many days are counted in an interest
-- period and the assumed number of days in a year (day-count basis).
-- ---------------------------------------------------------------------------
data DayCountConvention
  = Actual365Fixed
    -- ^ Actual days in period / 365 (ISDA standard for USD syndicated loans)
  | Actual360
    -- ^ Actual days in period / 360 (money-market convention)
  | Thirty360
    -- ^ 30 days per month / 360 (bond market convention)
  deriving (Show, Eq)

-- ---------------------------------------------------------------------------
-- | InterestAccrual
--
-- Tracks the running interest accrual for a specific TrancheParticipation.
-- Created by the agent at the start of each interest period and settled
-- at period end via CollectInterest.
--
-- PRIVACY: Same bilateral privacy as TrancheParticipation — only the agent
--          and the designated lender can see this contract.
--
-- Day-count conventions supported:
--   Actual365Fixed — standard for USD syndicated loans (LIBOR / SOFR)
--   Actual360      — common for EUR money-market instruments
--   Thirty360      — bond market (e.g. investment-grade term loans)
-- ---------------------------------------------------------------------------
template InterestAccrual
  with
    facilityId       : Text
      -- ^ Reference to the parent MasterFacility
    trancheId        : Text
      -- ^ Unique identifier for the accrual period (e.g. "ACCRUE-ALPHA-001")
    agent            : Party
      -- ^ Lead Agent who manages the accrual
    lender           : Party
      -- ^ Participant lender to whom interest is owed
    principalBalance : Decimal
      -- ^ Outstanding principal on which interest accrues
    marginSpreadBps  : Decimal
      -- ^ Margin component in basis points (bilaterally negotiated)
    baseRateBps      : Decimal
      -- ^ Reference rate (e.g. SOFR or LIBOR substitute) in basis points
    periodStartDate  : Date
      -- ^ Accrual period start date (inclusive)
    periodEndDate    : Date
      -- ^ Accrual period end date (exclusive)
    dayCountConvention : DayCountConvention
      -- ^ Day-count basis for interest calculation
    accruedInterest  : Decimal
      -- ^ Running accrued interest (updated on each AccrueInterest call)
    isSettled        : Bool
      -- ^ Whether this period's interest has been collected
  where
    signatory agent, lender
    -- No observers — strict bilateral privacy matching TrancheParticipation
    ensure
      principalBalance >= 0.0 &&
      marginSpreadBps >= 0.0 &&
      baseRateBps >= 0.0 &&
      accruedInterest >= 0.0 &&
      periodEndDate >= periodStartDate

    -- -----------------------------------------------------------------------
    -- Choice: AccrueInterest
    -- Controller: agent
    --
    -- Calculates and accumulates interest for a sub-period (e.g. daily or
    -- weekly accrual run). Uses the configured DayCountConvention.
    --
    -- Formula:
    --   totalRateBps = marginSpreadBps + baseRateBps
    --   interest     = principal * (totalRateBps / 10000) * (days / yearBasis)
    -- -----------------------------------------------------------------------
    choice AccrueInterest : ContractId InterestAccrual
      with
        accrualDate : Date
          -- ^ The date up to which interest is being accrued (must be within period)
      controller agent
      do
        assertMsg
          "Accrual date must be within the interest period"
          (accrualDate >= periodStartDate && accrualDate <= periodEndDate)
        assertMsg
          "Interest period is already settled"
          (not isSettled)

        -- Calculate days since period start (actual days)
        let actualDays  = subDate accrualDate periodStartDate
            yearBasis   = case dayCountConvention of
                            Actual365Fixed -> 365.0
                            Actual360      -> 360.0
                            Thirty360      -> 360.0
            -- For 30/360, months are treated as 30 days each
            -- For this implementation we use actual days for all conventions
            -- (full 30/360 date adjustment is a follow-up enhancement)
            totalRateBps = marginSpreadBps + baseRateBps
            periodInterest = principalBalance
                           * (totalRateBps / 10000.0)
                           * (intToDecimal actualDays / yearBasis)

        create this with
          accruedInterest = periodInterest

    -- -----------------------------------------------------------------------
    -- Choice: CollectInterest
    -- Controller: agent
    --
    -- Settles the accrued interest at period end, archiving this contract
    -- and creating an immutable InterestPaymentReceipt visible to the lender.
    -- -----------------------------------------------------------------------
    choice CollectInterest : (ContractId InterestPaymentReceipt)
      with
        settlementDate : Date
          -- ^ Date on which interest is actually transferred
      controller agent
      do
        assertMsg
          "Cannot collect before period end date"
          (settlementDate >= periodEndDate)
        assertMsg
          "Already settled"
          (not isSettled)
        assertMsg
          "No interest has been accrued yet"
          (accruedInterest > 0.0)

        create InterestPaymentReceipt with
          facilityId
          trancheId
          agent
          lender
          principalBalance
          accruedInterest
          marginSpreadBps
          baseRateBps
          dayCountConvention
          periodStartDate
          periodEndDate
          settlementDate

    -- -----------------------------------------------------------------------
    -- Choice: AdjustPrincipal
    -- Controller: agent
    --
    -- Updates the principal balance mid-period following a drawdown or
    -- repayment, resetting accrued interest to zero (accrual restarts).
    -- -----------------------------------------------------------------------
    choice AdjustPrincipal : ContractId InterestAccrual
      with
        newPrincipal   : Decimal
          -- ^ Updated outstanding principal
        adjustmentDate : Date
          -- ^ Date of the principal change
      controller agent
      do
        assertMsg
          "New principal must be non-negative"
          (newPrincipal >= 0.0)
        assertMsg
          "Adjustment date must be within the interest period"
          (adjustmentDate >= periodStartDate && adjustmentDate <= periodEndDate)
        create this with
          principalBalance = newPrincipal
          accruedInterest  = 0.0  -- Reset; AccrueInterest will recalculate
          periodStartDate  = adjustmentDate  -- Restart accrual from adjustment

-- ---------------------------------------------------------------------------
-- | InterestPaymentReceipt
--
-- Immutable, lender-specific audit confirmation generated when the agent
-- exercises CollectInterest on an InterestAccrual contract.
--
-- Provides a full audit trail including the rate components, day-count
-- convention used, and exact period dates for regulatory compliance.
--
-- PRIVACY: Only agent (signatory) and specific lender (observer) can see this.
-- ---------------------------------------------------------------------------
template InterestPaymentReceipt
  with
    facilityId       : Text
      -- ^ Reference to the parent MasterFacility
    trancheId        : Text
      -- ^ Accrual period identifier
    agent            : Party
      -- ^ Lead Agent who collected the interest
    lender           : Party
      -- ^ Participant lender who received the payment
    principalBalance : Decimal
      -- ^ Principal on which interest was calculated
    accruedInterest  : Decimal
      -- ^ Total interest amount collected
    marginSpreadBps  : Decimal
      -- ^ Margin component used in calculation
    baseRateBps      : Decimal
      -- ^ Reference rate component used in calculation
    dayCountConvention : DayCountConvention
      -- ^ Day-count convention applied
    periodStartDate  : Date
      -- ^ Start of the accrual period
    periodEndDate    : Date
      -- ^ End of the accrual period
    settlementDate   : Date
      -- ^ Actual settlement / payment date
  where
    signatory agent
    observer lender
    ensure accruedInterest >= 0.0

-- ---------------------------------------------------------------------------
-- | CovenantType
--
-- Enumerates the financial ratio covenants common in leveraged loan facilities.
-- Each covenant imposes a threshold on the borrower's financial health that,
-- if breached, gives lenders certain enforcement rights.
-- ---------------------------------------------------------------------------
data CovenantType
  = LeverageRatio
    -- ^ Total Net Debt / EBITDA. Typically set as a maximum (e.g. <= 4.5x).
    --   A higher ratio means more debt relative to earnings — a breach signals
    --   deteriorating credit quality.
  | DebtServiceCoverageRatio
    -- ^ EBITDA / (Interest + Principal). Minimum threshold (e.g. >= 1.25x).
    --   Measures borrower's ability to service debt from operating cash flow.
  | LoanToValue
    -- ^ Outstanding Loan / Appraised Asset Value. Max threshold (e.g. <= 75%).
    --   Used primarily in real estate and asset-backed lending.
  | MinimumLiquidity
    -- ^ Cash + undrawn revolver / monthly burn. Minimum threshold.
    --   Protects lenders against liquidity-driven defaults.
  | MaxCapex
    -- ^ Annual capital expenditure as % of EBITDA. Maximum threshold.
    --   Prevents the borrower from over-investing during the loan term.
  deriving (Show, Eq)

-- ---------------------------------------------------------------------------
-- | CovenantBreachStatus
--
-- Represents the compliance status of a covenant at a given test date.
-- ---------------------------------------------------------------------------
data CovenantBreachStatus
  = Compliant
    -- ^ Borrower is within the covenant threshold
  | Breached
    -- ^ Borrower has breached the threshold — cure period may apply
  | WaivedByAgent
    -- ^ Agent has waived the breach (requires lender consent in practice)
  | Accelerated
    -- ^ Loan has been accelerated following an uncured breach
  deriving (Show, Eq)

-- ---------------------------------------------------------------------------
-- | FacilityCovenants
--
-- Defines the financial maintenance covenants attached to a MasterFacility.
-- The regulator and all lenders are observers, enabling transparency while
-- keeping the specific threshold values bilaterally visible.
--
-- PRIVACY: Borrower + Agent are signatories. Regulator + all participant
--          lenders are observers (covenant status is shared information).
--
-- Testing frequency: Typically quarterly (every 90 days), aligned with
-- the borrower's financial reporting cycle.
-- ---------------------------------------------------------------------------
template FacilityCovenants
  with
    facilityId        : Text
      -- ^ Reference to the parent MasterFacility
    borrower          : Party
      -- ^ Corporate borrower whose ratios are being monitored
    agent             : Party
      -- ^ Lead Agent responsible for testing and enforcement
    lenders           : [Party]
      -- ^ All participant lenders — observers on covenant status
    regulator         : Optional Party
      -- ^ Regulatory observer (sees compliance status only)

    -- Covenant thresholds
    maxLeverageRatio  : Decimal
      -- ^ Maximum Net Debt / EBITDA (e.g. 4.5 for 4.5x)
    minDSCR           : Decimal
      -- ^ Minimum Debt Service Coverage Ratio (e.g. 1.25)
    maxLTV            : Decimal
      -- ^ Maximum Loan-to-Value ratio as a fraction (e.g. 0.75 for 75%)
    minLiquidity      : Decimal
      -- ^ Minimum liquidity balance in facility currency (e.g. 5,000,000)

    -- Current test results
    lastTestDate      : Date
      -- ^ Date of the most recent covenant test
    leverageActual    : Decimal
      -- ^ Borrower's actual leverage ratio at last test
    dscrActual        : Decimal
      -- ^ Borrower's actual DSCR at last test
    ltvActual         : Decimal
      -- ^ Borrower's actual LTV at last test
    liquidityActual   : Decimal
      -- ^ Borrower's actual liquidity at last test
    breachStatus      : CovenantBreachStatus
      -- ^ Current overall compliance status
    curePeriodDays    : Int
      -- ^ Days allowed for borrower to cure a breach (typically 30–45 days)

  where
    signatory borrower, agent
    observer lenders ++ (optionalToList regulator)
    ensure
      maxLeverageRatio > 0.0 &&
      minDSCR > 0.0 &&
      maxLTV > 0.0 && maxLTV <= 1.0 &&
      minLiquidity >= 0.0 &&
      curePeriodDays >= 0

    -- -----------------------------------------------------------------------
    -- Choice: TestCovenant
    -- Controller: agent
    --
    -- Runs the periodic covenant compliance test with the borrower's latest
    -- financial data. Updates the breach status and returns the new contract.
    --
    -- Breach logic (all must pass):
    --   leverageActual <= maxLeverageRatio
    --   dscrActual     >= minDSCR
    --   ltvActual      <= maxLTV
    --   liquidityActual >= minLiquidity
    -- -----------------------------------------------------------------------
    choice TestCovenant : ContractId FacilityCovenants
      with
        testDate         : Date
          -- ^ Date of the financial test
        newLeverage      : Decimal
          -- ^ Borrower-reported Net Debt / EBITDA
        newDSCR          : Decimal
          -- ^ Borrower-reported DSCR
        newLTV           : Decimal
          -- ^ Borrower-reported LTV
        newLiquidity     : Decimal
          -- ^ Borrower-reported liquidity balance
      controller agent
      do
        assertMsg "Test date must be on or after last test date"
          (testDate >= lastTestDate)
        assertMsg "Leverage ratio must be non-negative" (newLeverage >= 0.0)
        assertMsg "DSCR must be non-negative"           (newDSCR >= 0.0)
        assertMsg "LTV must be between 0 and 1"         (newLTV >= 0.0 && newLTV <= 1.0)
        assertMsg "Liquidity must be non-negative"      (newLiquidity >= 0.0)

        -- Evaluate breach conditions
        let leverageOk  = newLeverage  <= maxLeverageRatio
            dscrOk      = newDSCR      >= minDSCR
            ltvOk       = newLTV       <= maxLTV
            liquidityOk = newLiquidity >= minLiquidity
            allPass     = leverageOk && dscrOk && ltvOk && liquidityOk
            newStatus   = if allPass then Compliant else Breached

        create this with
          lastTestDate    = testDate
          leverageActual  = newLeverage
          dscrActual      = newDSCR
          ltvActual       = newLTV
          liquidityActual = newLiquidity
          breachStatus    = newStatus

    -- -----------------------------------------------------------------------
    -- Choice: WaiveCovenantBreach
    -- Controller: agent
    --
    -- The agent formally waives an existing breach (subject to lender consent
    -- in real deployments). Updates status to WaivedByAgent.
    -- Can only be exercised when breachStatus == Breached.
    -- -----------------------------------------------------------------------
    choice WaiveCovenantBreach : ContractId FacilityCovenants
      with
        waiverReason : Text
          -- ^ Free-text rationale for the waiver (stored on-ledger)
      controller agent
      do
        assertMsg "Can only waive an active breach" (breachStatus == Breached)
        assertMsg "Waiver reason must be provided"  (waiverReason /= "")
        create this with breachStatus = WaivedByAgent

    -- -----------------------------------------------------------------------
    -- Choice: AccelerateOnBreach
    -- Controller: agent
    --
    -- Declares loan acceleration after an uncured breach. This archives the
    -- FacilityCovenants contract and creates an immutable BreachNotice.
    -- In practice, acceleration requires majority lender consent.
    -- -----------------------------------------------------------------------
    choice AccelerateOnBreach : ContractId CovenantBreachNotice
      with
        accelerationDate : Date
          -- ^ Date on which acceleration is declared
        noticeText       : Text
          -- ^ Formal notice language
      controller agent
      do
        assertMsg "Acceleration only possible on Breached status"
          (breachStatus == Breached)
        assertMsg "Notice text must be provided" (noticeText /= "")

        create CovenantBreachNotice with
          facilityId
          borrower
          agent
          lenders
          regulator
          accelerationDate
          leverageAtBreach  = leverageActual
          dscrAtBreach      = dscrActual
          ltvAtBreach       = ltvActual
          liquidityAtBreach = liquidityActual
          noticeText

-- ---------------------------------------------------------------------------
-- | CovenantBreachNotice
--
-- Immutable on-ledger record of a covenant acceleration event.
-- Visible to borrower, agent, all lenders, and the regulator.
-- Serves as the authoritative audit trail for enforcement proceedings.
-- ---------------------------------------------------------------------------
template CovenantBreachNotice
  with
    facilityId        : Text
    borrower          : Party
    agent             : Party
    lenders           : [Party]
    regulator         : Optional Party
    accelerationDate  : Date
    leverageAtBreach  : Decimal
    dscrAtBreach      : Decimal
    ltvAtBreach       : Decimal
    liquidityAtBreach : Decimal
    noticeText        : Text
  where
    signatory agent
    observer [borrower] ++ lenders ++ (optionalToList regulator)
    ensure noticeText /= ""
